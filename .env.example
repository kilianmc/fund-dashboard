# ---------------------------------------------------------------------------
# Fund Portfolio Dashboard — environment variables
# Copy to `.env` (or `.env.local`) and fill in as needed. Never commit `.env`.
# ---------------------------------------------------------------------------

# FRONTEND (exposed to the browser — must be prefixed with VITE_)
# Base origin of the dashboard's own /api/nav serverless proxy. Because the
# remote runs on the SHELL's origin, it must call its backend by absolute URL.
#   - Same-origin (e.g. `vercel dev`, or deployed): leave empty.
#   - `npm run dev` (Vite) with no local API: point at a deployed origin, e.g.
#     https://ai-portfolio-project1.vercel.app
VITE_NAV_API_URL=

# BACKEND (server-only — NEVER prefix with VITE_, never shipped to the client)
# The default NAV provider is keyless Yahoo Finance, so NO key is required.
# These are only needed if you swap api/nav.js to a keyed provider adapter.
# NAV_PROVIDER=yahoo
# NAV_API_KEY=

# ---------------------------------------------------------------------------
# Fund Portfolio Dashboard — environment variables
# Copy to `.env` (or `.env.local`) and fill in as needed. Never commit `.env`.
# ---------------------------------------------------------------------------

# FRONTEND (exposed to the browser — must be prefixed with VITE_)
# OPTIONAL override for the origin of the dashboard's own /api/nav serverless
# proxy. Leave empty in normal use: navService.js resolves the origin from its
# own module URL (import.meta.url), so a deployed build calls its own backend
# even when federated into the shell on kilianmc.com.
# Set it only to point somewhere else, e.g. `npm run dev` (plain Vite, no local
# serverless runtime) against a deployed proxy:
#   VITE_NAV_API_URL=https://ai-portfolio-project1.vercel.app
VITE_NAV_API_URL=

# BACKEND (server-only — NEVER prefix with VITE_, never shipped to the client)
# The default NAV provider is keyless Yahoo Finance, so NO key is required.
# These are only needed if you swap api/nav.js to a keyed provider adapter.
# NAV_PROVIDER=yahoo
# NAV_API_KEY=
